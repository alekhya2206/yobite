# .env.example  (copy to .env.local and fill in — both are free-tier)
# Gemini Flash — primary vision model (reads the menu image). Get a key: https://aistudio.google.com/apikey
# (Goal/intent parsing is deterministic in v1 and needs no key.)
GEMINI_API_KEY=
# OpenRouter (Qwen-VL fallback). Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
