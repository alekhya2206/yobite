# .env.example  (copy to .env.local and fill in — all free-tier)
# Groq — PRIMARY AI: reads the menu image (vision) + parses meal intent (text).
# Free tier, very fast. Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Gemini Flash — optional fallback (vision + intent). Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (Qwen-VL) — optional extra vision fallback. Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
